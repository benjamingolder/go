@startuml

class auto {
    - id: String (final)
    - marke: String (final)
    - modell: String (final)
    - sitze: int (final)
    - türen: int (final)
    - kraftstoff: enum { BENZIN, DIESEL, ELEKTRO, HYBRID } (final)
    - getriebe: String (final)
    - kennzeichen: String (final)
    - nutzlast: double (final)
    - ladevolumen: double (final)
    - status: enum { VERFUEGBAR, VERMIETET, WARTUNG }
}

class mitarbeiter {
    - entraID: String
    - name: String
    - vorname: String
    - geburtsdatum: Date
    - personalnummer: String
    - abteilung: String
    - rolle: enum { MITARBEITER, ADMIN }
}

class reservierung {
    - id: String
    - reservierungsnummer: String
    - startdatum: Date
    - enddatum: Date
    - status: enum { PROVISORISCH, BESTAETIGT, AKTIV, ABGESCHLOSSEN, ABGESAGT }
}

mitarbeiter "1" -- "0..*" reservierung
auto "1" -- "0..*" reservierung

@enduml